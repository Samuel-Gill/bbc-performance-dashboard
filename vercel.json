{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/starter-workbook",
      "destination": "/api/starter-workbook"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/starter-workbook.js": {
      "includeFiles": "private/starter.xlsx"
    }
  }
}
